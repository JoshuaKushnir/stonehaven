---
import { site, nav } from '../lib/site';

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[color:var(--color-bone)]/85 border-b border-[color:var(--color-slate)]/8">
  <div class="container-prose flex items-center justify-between py-5">
    <a href="/" class="flex items-baseline gap-3 group" aria-label="Stonehaven home">
      <span class="font-display text-2xl tracking-tight text-[color:var(--color-ink)] group-hover:text-[color:var(--color-moss-deep)] transition-colors">
        Stonehaven
      </span>
      <span class="hidden md:inline eyebrow">Landscape Studio</span>
    </a>

    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-8 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition-colors',
                isActive(item.href)
                  ? 'text-[color:var(--color-ink)]'
                  : 'text-[color:var(--color-stone)] hover:text-[color:var(--color-ink)]',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/contact" class="hidden md:inline-flex btn btn-primary">
      Begin a Project
    </a>

    <button
      type="button"
      class="md:hidden inline-flex items-center text-[color:var(--color-ink)]"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-mobile-toggle
    >
      <span class="sr-only">Open menu</span>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="md:hidden hidden border-t border-[color:var(--color-slate)]/8" aria-label="Mobile">
    <ul class="container-prose py-4 grid gap-3 text-base">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="block py-1 text-[color:var(--color-ink)]">{item.label}</a>
        </li>
      ))}
      <li class="pt-2"><a href="/contact" class="btn btn-primary w-full justify-center">Begin a Project</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
