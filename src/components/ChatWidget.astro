---
// Inline = render as an embedded card on a page (e.g. above the contact form).
// Default (no prop) = floating button + slide-up panel, mounted site-wide.
interface Props {
  variant?: 'floating' | 'inline';
}
const { variant = 'floating' } = Astro.props;
---

{variant === 'floating' && (
  <button
    type="button"
    id="chat-launcher"
    aria-label="Open studio assistant"
    aria-controls="chat-panel"
    aria-expanded="false"
    class="fixed bottom-6 right-6 z-40 inline-flex items-center gap-2 bg-[color:var(--color-ink)] text-[color:var(--color-bone)] px-5 py-3 text-sm tracking-wide shadow-[0_8px_24px_rgb(26_26_23_/_0.18)] hover:bg-[color:var(--color-moss-deep)] transition-colors"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M21 12a8 8 0 0 1-12.3 6.75L3 20l1.3-5.07A8 8 0 1 1 21 12Z"/>
    </svg>
    <span>Ask the studio</span>
  </button>
)}

<div
  id="chat-panel"
  class:list={[
    variant === 'floating'
      ? 'fixed bottom-6 right-6 z-50 hidden w-[min(420px,calc(100vw-3rem))] h-[min(620px,calc(100vh-8rem))] flex-col bg-[color:var(--color-bone)] border border-[color:var(--color-slate)]/15 shadow-[0_24px_48px_rgb(26_26_23_/_0.18)]'
      : 'flex w-full max-w-2xl mx-auto bg-[color:var(--color-paper)] border border-[color:var(--color-slate)]/15 h-[min(560px,80vh)] flex-col',
  ]}
  role="dialog"
  aria-label="Studio assistant"
>
  <header class="flex items-center justify-between px-5 py-4 border-b border-[color:var(--color-slate)]/12 shrink-0">
    <div>
      <p class="eyebrow">Studio Assistant</p>
      <p class="font-display text-lg text-[color:var(--color-ink)] mt-0.5">An apprentice, of a kind.</p>
    </div>
    {variant === 'floating' && (
      <button
        type="button"
        id="chat-close"
        aria-label="Close studio assistant"
        class="text-[color:var(--color-stone)] hover:text-[color:var(--color-ink)] transition-colors p-1"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 6l12 12M6 18L18 6"/>
        </svg>
      </button>
    )}
  </header>

  <div
    id="chat-log"
    role="log"
    aria-live="polite"
    class="flex-1 overflow-y-auto px-5 py-5 space-y-5 text-sm leading-[1.6]"
  ></div>

  <form id="chat-form" class="border-t border-[color:var(--color-slate)]/12 px-5 py-4 shrink-0">
    <label for="chat-input" class="sr-only">Message</label>
    <div class="flex items-end gap-3">
      <textarea
        id="chat-input"
        rows="1"
        placeholder="Tell us about your project…"
        autocomplete="off"
        class="flex-1 resize-none bg-transparent border-0 border-b border-[color:var(--color-slate)]/25 focus:border-[color:var(--color-ink)] py-2 text-sm focus:outline-none focus:ring-0 transition-colors placeholder:text-[color:var(--color-stone)]/60 max-h-32"
      ></textarea>
      <button
        type="submit"
        id="chat-send"
        aria-label="Send message"
        class="shrink-0 inline-flex items-center justify-center w-10 h-10 bg-[color:var(--color-ink)] text-[color:var(--color-bone)] hover:bg-[color:var(--color-moss-deep)] disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </button>
    </div>
    <p class="mt-3 text-[10px] uppercase tracking-[0.16em] text-[color:var(--color-stone)]/70">
      Conversational intake · responses are AI-assisted · the studio reviews every note
    </p>
  </form>
</div>

<style is:global>
  #chat-log .msg { display: flex; gap: 0.75rem; }
  #chat-log .msg-user { justify-content: flex-end; }
  #chat-log .msg-user .bubble {
    background: var(--color-ink);
    color: var(--color-bone);
    padding: 0.6rem 0.9rem;
    max-width: 80%;
  }
  #chat-log .msg-assistant .bubble {
    color: var(--color-slate);
    max-width: 92%;
    white-space: pre-wrap;
  }
  #chat-log .msg-assistant .bubble::before {
    content: '— ';
    color: var(--color-moss);
  }
  #chat-log .cursor::after {
    content: '▍';
    display: inline-block;
    color: var(--color-moss);
    animation: chat-blink 1s steps(2, start) infinite;
    margin-left: 1px;
  }
  @keyframes chat-blink { to { visibility: hidden; } }
</style>

<script>
  (() => {
    const panel = document.getElementById('chat-panel');
    const launcher = document.getElementById('chat-launcher');
    const closeBtn = document.getElementById('chat-close');
    const log = document.getElementById('chat-log') as HTMLDivElement | null;
    const form = document.getElementById('chat-form') as HTMLFormElement | null;
    const input = document.getElementById('chat-input') as HTMLTextAreaElement | null;
    const send = document.getElementById('chat-send') as HTMLButtonElement | null;
    if (!panel || !log || !form || !input || !send) return;

    // Prevent re-init if widget appears twice on a page (floating + inline)
    if ((panel as HTMLElement & { __init?: boolean }).__init) return;
    (panel as HTMLElement & { __init?: boolean }).__init = true;

    type Msg = { role: 'user' | 'assistant'; content: string };
    const STORAGE_KEY = 'stonehaven_chat_v1';

    function load(): Msg[] {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch { return []; }
    }
    function save(msgs: Msg[]) {
      try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(msgs)); } catch {}
    }

    let messages: Msg[] = load();

    function renderInitial() {
      log!.innerHTML = '';
      if (messages.length === 0) {
        const intro = document.createElement('div');
        intro.className = 'msg msg-assistant';
        intro.innerHTML = `<div class="bubble">Welcome — I'm the studio's assistant. If you'd like, tell me a little about the property you have in mind and what you're hoping the garden will do. I'll relay the conversation to Margaret and Daniel.</div>`;
        log!.appendChild(intro);
      } else {
        for (const m of messages) appendMessage(m.role, m.content);
      }
      scrollToBottom();
    }

    function appendMessage(role: 'user' | 'assistant', content: string) {
      const wrap = document.createElement('div');
      wrap.className = `msg msg-${role}`;
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.textContent = content;
      wrap.appendChild(bubble);
      log!.appendChild(wrap);
      return bubble;
    }
    function scrollToBottom() {
      log!.scrollTop = log!.scrollHeight;
    }

    function setOpen(open: boolean) {
      if (panel!.classList.contains('hidden') === open) {
        panel!.classList.toggle('hidden', !open);
      }
      if (panel!.tagName !== 'DIV') return;
      if (launcher) launcher.setAttribute('aria-expanded', String(open));
      if (open) {
        renderInitial();
        setTimeout(() => input!.focus(), 80);
      }
    }

    launcher?.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));

    // Auto-grow textarea
    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 128) + 'px';
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || send.disabled) return;
      input.value = '';
      input.style.height = 'auto';

      messages.push({ role: 'user', content: text });
      save(messages);
      appendMessage('user', text);
      scrollToBottom();

      send.disabled = true;
      const reply = appendMessage('assistant', '');
      reply.classList.add('cursor');

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages }),
        });
        if (!res.ok || !res.body) throw new Error('upstream');

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let assembled = '';

        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() ?? '';
          for (const line of lines) {
            if (!line.startsWith('data: ')) continue;
            const payload = line.slice(6).trim();
            if (payload === '[DONE]') break;
            try {
              const parsed = JSON.parse(payload);
              if (parsed.delta) {
                assembled += parsed.delta;
                reply.textContent = assembled;
                scrollToBottom();
              }
            } catch {}
          }
        }

        reply.classList.remove('cursor');
        messages.push({ role: 'assistant', content: assembled });
        save(messages);
      } catch (err) {
        reply.classList.remove('cursor');
        reply.textContent =
          "Something went wrong reaching the studio's assistant. Please use the contact form below — Margaret or Daniel will be in touch within two business days.";
      } finally {
        send.disabled = false;
        input.focus();
      }
    });

    if (panel.classList.contains('hidden') === false) {
      // inline variant — render messages immediately
      renderInitial();
    }
  })();
</script>
