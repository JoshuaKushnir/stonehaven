---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { pageJsonLd } from '../lib/seo';

const team = await getCollection('team');

const jsonLd = pageJsonLd({
  type: 'AboutPage',
  name: 'About the Studio',
  description: 'Stonehaven is a small landscape architecture and design-build studio led by Margaret Wren, ASLA, and Daniel Harlowe. We work on a small number of projects each year.',
  url: new URL('/about', site.url).toString(),
});

const values = [
  {
    title: 'Small and stays small',
    body: 'Six new projects a year. The same hands on the work from first sketch to the final planting.',
  },
  {
    title: 'Build in-house',
    body: 'Our masons are on staff, not subcontracted. The studio owns the quality of every joint, every grade.',
  },
  {
    title: 'Native and naturalized',
    body: 'Planting palettes drawn from the surrounding landscape. We plant for permanence, not for the first photograph.',
  },
  {
    title: 'Slow handover',
    body: 'Every project rolls into estate management. The studio that built the garden tends the garden.',
  },
];
---

<Base
  title="About the Studio"
  description="A small landscape architecture and design-build studio in Hudson, NY. Led by Margaret Wren, ASLA, and Daniel Harlowe."
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="container-prose pt-16 md:pt-28 pb-12 md:pb-20 grid md:grid-cols-12 gap-x-10 items-end">
    <div class="md:col-span-7">
      <p class="eyebrow">The Studio</p>
      <h1 class="mt-5 font-display text-5xl md:text-6xl">
        Founded in {site.founded}<br />on Warren Street.
      </h1>
    </div>
    <div class="md:col-span-5 md:pl-6 mt-8 md:mt-0">
      <p class="text-[color:var(--color-slate)] text-lg leading-[1.55]">
        Stonehaven is a landscape architecture and design-build studio working between the Hudson Valley, Westchester, and Fairfield County. We were founded on a single belief: that the garden you design is only as good as the people who build it.
      </p>
    </div>
  </section>

  <!-- IMAGE BAND -->
  <section class="relative">
    <figure class="relative aspect-[16/8] overflow-hidden">
      <img
        src="/img/stonehaven-studio-band.svg?w=2000&h=1000"
        alt="The studio's stone yard in Hudson, NY"
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
      />
    </figure>
  </section>

  <!-- VALUES -->
  <section class="container-prose mt-24 md:mt-36">
    <div class="grid md:grid-cols-12 gap-x-10 gap-y-10">
      <div class="md:col-span-5">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-4 font-display text-4xl md:text-5xl">
          Four principles<br />everything follows.
        </h2>
      </div>
      <ul class="md:col-span-7 md:pl-6 grid sm:grid-cols-2 gap-x-10 gap-y-10 list-none p-0">
        {values.map((v, i) => (
          <li>
            <p class="font-mono text-xs text-[color:var(--color-stone)]">0{i + 1}</p>
            <h3 class="mt-3 font-display text-2xl">{v.title}</h3>
            <p class="mt-2 text-sm text-[color:var(--color-slate)] leading-relaxed">{v.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TEAM -->
  <section class="container-prose mt-32 md:mt-44">
    <p class="eyebrow">Principals</p>
    <h2 class="mt-4 font-display text-4xl md:text-5xl">The studio leads</h2>

    <div class="mt-16 md:mt-20 grid md:grid-cols-2 gap-x-12 gap-y-20">
      {team.map((member) => (
        <article class="group">
          <figure class="relative aspect-[4/5] overflow-hidden">
            <img
              src={member.data.portrait}
              alt={member.data.name}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
              loading="lazy"
            />
          </figure>
          <h3 class="mt-6 font-display text-3xl">{member.data.name}</h3>
          <p class="mt-1 eyebrow">{member.data.title}</p>
          <p class="mt-5 text-[color:var(--color-slate)] leading-relaxed">{member.data.bio}</p>
          {member.data.credentials && (
            <ul class="mt-6 space-y-1 text-sm text-[color:var(--color-stone)] hairline pt-5">
              {member.data.credentials.map((c: string) => <li>— {c}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- RECOGNITION -->
  <section class="mt-32 md:mt-44 py-20 md:py-28 bg-[color:var(--color-paper)]">
    <div class="container-prose grid md:grid-cols-12 gap-x-10">
      <div class="md:col-span-4">
        <p class="eyebrow">Recognition</p>
        <h2 class="mt-4 font-display text-3xl md:text-4xl">Published & awarded</h2>
      </div>
      <ul class="md:col-span-8 md:pl-6 mt-8 md:mt-0 grid sm:grid-cols-2 gap-y-6 gap-x-8 list-none p-0 text-sm text-[color:var(--color-slate)]">
        <li>ASLA Honor Award · Residential Design · 2024</li>
        <li>House & Garden · Featured Studio · 2023</li>
        <li>Garden Design Magazine · Cover · Fall 2023</li>
        <li>Dwell · Outdoor Issue · 2022</li>
        <li>The New York Times · T Magazine · 2022</li>
        <li>Hudson Valley AIA · Built Honor · 2021</li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-prose mt-24 md:mt-36 mb-24 md:mb-36 hairline pt-16 grid md:grid-cols-12 gap-x-10 items-end">
    <div class="md:col-span-7">
      <h2 class="font-display text-4xl md:text-5xl">
        We'd be glad to<br />hear about your site.
      </h2>
    </div>
    <div class="md:col-span-5 md:text-right mt-8 md:mt-0">
      <a href="/contact" class="btn btn-primary">Begin a Project</a>
    </div>
  </section>
</Base>
