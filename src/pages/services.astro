---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { pageJsonLd } from '../lib/seo';

const services = (await getCollection('services')).sort((a, b) => a.data.id.localeCompare(b.data.id));

const jsonLd = pageJsonLd({
  type: 'WebPage',
  name: 'Services',
  description: 'Landscape architecture, hardscape & masonry, planting & horticulture, and estate management — the full arc of design and build for considered homes.',
  url: new URL('/services', site.url).toString(),
});
---

<Base
  title="Services"
  description="Landscape architecture, hardscape & masonry, planting & horticulture, and estate management — the full arc of design and build for considered homes."
  jsonLd={jsonLd}
>
  <!-- INTRO -->
  <section class="container-prose pt-16 md:pt-28 pb-12 md:pb-20">
    <p class="eyebrow">Services</p>
    <h1 class="mt-5 font-display text-5xl md:text-6xl max-w-3xl">
      Design, build, and tend —<br />in that order.
    </h1>
    <p class="mt-8 max-w-2xl text-lg text-[color:var(--color-slate)]">
      The studio offers four services that build on one another. Most clients engage us across all four; some only for design, or only for management. We are happy either way, provided the work that bears our name is work we control end to end.
    </p>
  </section>

  <!-- SERVICES -->
  <section class="container-prose space-y-32 md:space-y-44 pb-32 md:pb-48">
    {services.map((s, i) => (
      <article id={s.data.slug} class="grid md:grid-cols-12 gap-x-10 gap-y-10 items-start scroll-mt-24">
        <div class={`md:col-span-7 ${i % 2 === 1 ? 'md:order-2' : ''}`}>
          <figure class="relative aspect-[4/3] overflow-hidden">
            <img
              src={s.data.image}
              alt={s.data.title}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </figure>
        </div>
        <div class={`md:col-span-5 ${i % 2 === 1 ? 'md:order-1 md:pr-6' : 'md:pl-6'}`}>
          <p class="eyebrow">{s.data.eyebrow}</p>
          <h2 class="mt-3 font-display text-4xl">{s.data.title}</h2>
          <p class="mt-5 text-[color:var(--color-slate)]">{s.data.description}</p>
          <ul class="mt-7 space-y-2.5 text-sm text-[color:var(--color-slate)] hairline pt-7">
            {s.data.bullets.map((b: string) => (
              <li class="flex gap-3">
                <span class="text-[color:var(--color-moss)] mt-[2px]">—</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          {s.data.priceFrom && (
            <p class="mt-7 text-xs uppercase tracking-[0.16em] text-[color:var(--color-stone)]">
              {s.data.priceFrom}
            </p>
          )}
        </div>
      </article>
    ))}
  </section>

  <!-- CTA -->
  <section class="mb-24 md:mb-36">
    <div class="container-prose hairline pt-16 grid md:grid-cols-12 gap-x-10 items-end">
      <div class="md:col-span-7">
        <p class="eyebrow">Next step</p>
        <h2 class="mt-4 font-display text-3xl md:text-4xl">
          Talk through your project<br />with the studio.
        </h2>
      </div>
      <div class="md:col-span-5 md:text-right mt-8 md:mt-0">
        <a href="/contact" class="btn btn-primary">Begin a Project</a>
      </div>
    </div>
  </section>
</Base>
