---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/site';
import { projectJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const sorted = projects.sort((a, b) => b.data.year - a.data.year);
  return sorted.map((p, i) => ({
    params: { id: p.id },
    props: {
      project: p,
      prev: sorted[(i - 1 + sorted.length) % sorted.length],
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);

const jsonLd = projectJsonLd({
  title: project.data.title,
  summary: project.data.summary,
  location: project.data.location,
  year: project.data.year,
  coverImage: project.data.coverImage,
  url: new URL(`/projects/${project.id}`, site.url).toString(),
});
---

<Base
  title={project.data.title}
  description={project.data.summary}
  image={project.data.coverImage}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="relative">
    <figure class="relative aspect-[16/10] md:aspect-[16/7] overflow-hidden">
      <img
        src={project.data.coverImage}
        alt={project.data.title}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <!-- HEADER + META -->
  <section class="container-prose mt-14 md:mt-20 grid md:grid-cols-12 gap-x-10 gap-y-10">
    <div class="md:col-span-7">
      <p class="eyebrow">{project.data.category} — {project.data.year}</p>
      <h1 class="mt-4 font-display text-5xl md:text-6xl">{project.data.title}</h1>
      <p class="mt-3 text-lg text-[color:var(--color-stone)]">{project.data.location}</p>
      <p class="mt-8 text-xl text-[color:var(--color-slate)] leading-[1.55]">{project.data.summary}</p>
    </div>
    <aside class="md:col-span-5 md:pl-8 md:border-l border-[color:var(--color-slate)]/15 space-y-7 text-sm">
      <div>
        <p class="eyebrow mb-3">Scope</p>
        <ul class="space-y-1 text-[color:var(--color-slate)]">
          {project.data.scope.map((s: string) => <li>{s}</li>)}
        </ul>
      </div>
      {project.data.materials && (
        <div>
          <p class="eyebrow mb-3">Materials</p>
          <ul class="space-y-1 text-[color:var(--color-slate)]">
            {project.data.materials.map((m: string) => <li>{m}</li>)}
          </ul>
        </div>
      )}
      {project.data.collaborators && (
        <div>
          <p class="eyebrow mb-3">Collaborators</p>
          <ul class="space-y-1 text-[color:var(--color-slate)]">
            {project.data.collaborators.map((c: string) => <li>{c}</li>)}
          </ul>
        </div>
      )}
    </aside>
  </section>

  <!-- STORY -->
  <section class="container-prose mt-20 md:mt-28">
    <div class="prose-body max-w-2xl text-lg text-[color:var(--color-slate)] leading-[1.7] space-y-6 [&_p]:m-0">
      <Content />
    </div>
  </section>

  <!-- GALLERY -->
  <section class="container-prose mt-24 md:mt-32 grid md:grid-cols-12 gap-x-6 gap-y-6">
    {project.data.gallery.map((src: string, i: number) => {
      const layouts = [
        'md:col-span-8',
        'md:col-span-4 md:mt-20',
        'md:col-span-5',
        'md:col-span-7 md:mt-16',
        'md:col-span-6',
        'md:col-span-6 md:mt-12',
      ];
      const cls = layouts[i % layouts.length];
      return (
        <figure class={`${cls} relative aspect-[4/3] overflow-hidden`}>
          <img src={src} alt={`${project.data.title} — image ${i + 2}`} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        </figure>
      );
    })}
  </section>

  <!-- PREV / NEXT -->
  <section class="container-prose mt-32 md:mt-40 hairline pt-10 pb-32 grid md:grid-cols-2 gap-10">
    <a href={`/projects/${prev.id}`} class="group">
      <p class="eyebrow">Previous</p>
      <p class="mt-3 font-display text-2xl md:text-3xl group-hover:text-[color:var(--color-moss-deep)] transition-colors">
        ← {prev.data.title}
      </p>
      <p class="mt-1 text-sm text-[color:var(--color-stone)]">{prev.data.location}</p>
    </a>
    <a href={`/projects/${next.id}`} class="group md:text-right">
      <p class="eyebrow">Next</p>
      <p class="mt-3 font-display text-2xl md:text-3xl group-hover:text-[color:var(--color-moss-deep)] transition-colors">
        {next.data.title} →
      </p>
      <p class="mt-1 text-sm text-[color:var(--color-stone)]">{next.data.location}</p>
    </a>
  </section>
</Base>
