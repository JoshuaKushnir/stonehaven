# Required only if you want quote-form emails to actually send.
# Without these set, the form endpoint logs to the server console and
# returns success — useful for local development.
RESEND_API_KEY=
QUOTE_TO_EMAIL=studio@stonehaven.example
QUOTE_FROM_EMAIL=onboarding@resend.dev

# Public site URL — used for sitemap, OpenGraph, canonical URLs.
SITE_URL=https://stonehaven-studio.example.com

# Optional: switch the content layer from local content collections to Sanity.
# When unset the site reads from src/content/ (committed, version-controlled).
SANITY_PROJECT_ID=
SANITY_DATASET=production

# AI Studio Assistant — OpenAI-powered chat widget at /api/chat.
# Without these, the widget returns a graceful "assistant offline" fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
